# ============================================
# CONFIGURACIÓN MULTI-NUBE
# ============================================
# El sistema detecta automáticamente qué proveedor usar
# basado en las variables de entorno configuradas.
# 
# OPCIONES:
# 1. GCP (Vertex AI) - Configura variables de GCP
# 2. Azure (Azure AI Search) - Configura variables de Azure
# 3. OpenAI - Configura OPENAI_API_KEY (para embeddings)
# ============================================

# MongoDB (requerido para todos)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=supermarket_db

# ============================================
# OPCIÓN 1: GCP (Google Cloud Platform)
# ============================================
# Descomenta y configura estas variables para usar GCP

# GCP Project
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=us-central1
# GCP_LOCATION=us-central1

# Vertex AI Vector Search
# VECTOR_SEARCH_INDEX_ID=your-index-id
# VECTOR_SEARCH_ENDPOINT_ID=your-endpoint-id
# VECTOR_SEARCH_DEPLOYED_INDEX_ID=your-deployed-index-id

# Pub/Sub (opcional)
# PUBSUB_TOPIC_PRODUCT_UPDATES=product-updates
# PUBSUB_SUBSCRIPTION_NAME=product-updates-subscription

# GCP Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ============================================
# OPCIÓN 2: AZURE
# ============================================
# Descomenta y configura estas variables para usar Azure

# Azure AI Search
# AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
# AZURE_SEARCH_API_KEY=your-api-key
# AZURE_SEARCH_INDEX_NAME=products-index

# ============================================
# OPCIÓN 3: OPENAI (para embeddings)
# ============================================
# Descomenta y configura estas variables para usar OpenAI
# (puede combinarse con GCP o Azure para Vector Search)

# OpenAI
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # o text-embedding-3-large

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================
API_PORT=8000
ENVIRONMENT=development

# ============================================
# NOTAS:
# ============================================
# - Para embeddings: GCP_PROJECT_ID o OPENAI_API_KEY
# - Para Vector Search: VECTOR_SEARCH_ENDPOINT_ID (GCP) o AZURE_SEARCH_ENDPOINT (Azure)
# - El sistema detecta automáticamente qué proveedor usar
# - Puedes mezclar: OpenAI para embeddings + Azure para Vector Search
# ============================================
